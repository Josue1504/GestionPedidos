# Root gitignore for monorepo (frontend + backend)

# Node & tooling
node_modules/
pnpm-lock.yaml
# keep lockfiles tracked unless explicitly ignored
# package-lock.json

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Logs / coverage
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log
coverage/

# Builds
/build/
/dist/
.out/
.next/

# Env files (keep examples)
.env
.env.*
!.env.example

# Backend: ignore local-only artifacts
servidor-api/backups/
servidor-api/cookie.txt
servidor-api/database_export*.sql

# Cache/temp
*.tmp
*.swp
